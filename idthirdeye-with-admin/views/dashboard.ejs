<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard &mdash; idThirdeye Technology Solutions</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<header class="dash-header">
  <div class="dash-header__inner">
    <div class="dash-brand">
      <svg viewBox="0 0 40 40" width="24" height="24">
        <path d="M2 20 Q20 4 38 20 Q20 36 2 20 Z" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="20" cy="20" r="6" fill="currentColor"/>
      </svg>
      <span>idThirdeye</span>
    </div>
    <div class="dash-user">
      <span>Signed in as <strong><%= user.full_name %></strong></span>
      <form method="POST" action="/logout" style="margin:0">
        <button type="submit" class="logout-btn">Log out</button>
      </form>
    </div>
  </div>
</header>

<main class="dash-main">
  <div class="dash-welcome">
    <p class="eyebrow">DASHBOARD</p>
    <h1>Welcome back, <%= user.full_name.split(' ')[0] %>.</h1>
    <p class="sub">Here's where your account and the company site connect.</p>
  </div>

  <div class="dash-grid">

    <div class="dash-card">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="4" width="18" height="14" rx="2"/>
        <path d="M3 9h18M8 4v14"/>
      </svg>
      <h3>Visit the company site</h3>
      <p>See the idThirdeye Technology Solutions website — services, approach, case studies, and contact.</p>
      <a href="/idthirdeye" class="card-link">Open site &rarr;</a>
    </div>

    <div class="dash-card">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
      </svg>
      <h3>Account details</h3>
      <p>
        <strong><%= user.full_name %></strong><br>
        <%= user.email %><br>
        Member since <%= new Date(user.created_at).toLocaleDateString('en-IN', {
          year: 'numeric', month: 'long', day: 'numeric'
        }) %>
      </p>
    </div>

    <div class="dash-card">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <h3>Admin Panel</h3>
      <p>Administrators can view and manage all registered users, and inspect the backend database from the browser.</p>
      <a href="/admin/login" class="card-link">Go to admin &rarr;</a>
    </div>

  </div>
</main>

</body>
</html>
